# Database configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nativetravel_db
SPRING_DATASOURCE_USERNAME=nativetravel_user
SPRING_DATASOURCE_PASSWORD=nativetravel_secret_pass

# Mail configuration (MailHog for local dev)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# JWT Secrets (Generated via `openssl rand -base64 64`)
# Example 512-bit base64 secret:
JWT_SECRET=c3VwZXJTZWNyZXRUb2tlbktleUZvck5hdGl2ZVRyYXZlbEFwcGxpY2F0aW9uMjAyNlNlY3VyZUtleUZvcldlYg==
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Telegram Bot configuration
TELEGRAM_BOT_USERNAME=NativeTravelSupportBot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Server configuration
PORT=8080
APP_BASE_URL=http://localhost:8080
# Spring Cloud: shared credential for internal service-to-service HTTP.
INTERNAL_SERVICE_TOKEN=local-development-service-token
